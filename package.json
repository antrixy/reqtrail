{
  "name": "reqtrail",
  "version": "0.1.0",
  "description": "See the request before it is sent: a local, Git-friendly HTTP request inspector with per-value provenance.",
  "license": "MIT",
  "author": "Maverick Yadav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antrixy/reqtrail.git"
  },
  "bugs": {
    "url": "https://github.com/antrixy/reqtrail/issues"
  },
  "homepage": "https://github.com/antrixy/reqtrail#readme",
  "keywords": [
    "http",
    "api",
    "cli",
    "request",
    "provenance",
    "inspector"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reqtrail": "bin/reqtrail.js"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "pretest": "node scripts/build-ui.mjs",
    "test": "node test/selftest.mjs && node test/ui.mjs && node test/parity.mjs && node test/server.mjs",
    "test:selftest": "node test/selftest.mjs",
    "pretest:ui": "node scripts/build-ui.mjs",
    "test:ui": "node test/ui.mjs",
    "test:parity": "node test/parity.mjs",
    "test:server": "node test/server.mjs",
    "test:mutation": "node test/mutate.mjs",
    "prepack": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
